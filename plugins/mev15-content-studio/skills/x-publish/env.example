# x-publish 凭据与配置模板
# 使用：复制本文件到 ~/.config/x-publish/env 并填写，chmod 600
# 优先级：进程环境变量 > 该配置文件
# token 由脚本管理，存于同目录 tokens.json（--login 生成，自动续期）

# X 开发者后台（developer.x.com）→ 你的 App → OAuth 2.0 Client ID
X_CLIENT_ID=你的ClientID

# 必须与 App 的 User authentication settings 里配置的 Callback URL 完全一致
# （无需真的有服务监听：授权后浏览器跳转失败没关系，把地址栏 URL 粘回终端即可）
X_REDIRECT_URI=http://localhost:8917/callback

# 可选：仅 confidential client（Web App / Automated App）需要；Native App（public client）留空
#X_CLIENT_SECRET=你的ClientSecret
